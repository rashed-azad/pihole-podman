# Podman Quadlet template. install.sh fills in @PIHOLE_IP@
# and copies the result to ~/.config/containers/systemd/pihole.container
[Unit]
Description=Pi-hole (rootless Podman)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/pihole/pihole:latest
ContainerName=pihole
# Keep the real client IP (default rootless mode hides it)
Network=slirp4netns:port_handler=slirp4netns
# DNS only on the LAN IP, so it does not clash with systemd-resolved (127.0.0.53)
PublishPort=@PIHOLE_IP@:53:53/tcp
PublishPort=@PIHOLE_IP@:53:53/udp
PublishPort=8080:80/tcp
Environment=TZ=Europe/Berlin
Environment=FTLCONF_dns_listeningMode=all
# Upstream DNS servers (separate with ;)
Environment="FTLCONF_dns_upstreams=1.1.1.1;1.0.0.1"
# Never hand out IPv6 (AAAA) answers to LAN clients. Disabling IPv6 on the
# host (setup-host.sh) does NOT do this by itself: clients still query over
# IPv4 for AAAA records, so this dnsmasq directive is what actually stops it.
Environment="FTLCONF_misc_dnsmasq_lines=filter-AAAA"
EnvironmentFile=%h/.config/pihole/pihole.env
Volume=%h/.local/share/pihole/etc-pihole:/etc/pihole
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target